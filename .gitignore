.env
# Backups and variants too: .gitignore matched only the exact
# name, so a `.env.bak` sat in the working tree as an untracked
# file that `git add -A` would have committed.
.env.*
!.env.example
config.local.yaml
data/
logs/
KILL
__pycache__/
*.pyc
.venv/

# QA reports (saved web pages)
trading-bot QA*.html
trading-bot QA*_files/
