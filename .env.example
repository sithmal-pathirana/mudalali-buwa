# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------- exchange
# ---- TESTNET / DEMO (get these first; all you need for weeks) ---------------
# Binance moved the futures testnet UI. testnet.binancefuture.com now
# 301-redirects to demo.binance.com. The API HOST IS UNCHANGED -- the bot still
# talks to testnet.binancefuture.com, which serves normally. Only the page
# where you collect the keys moved.
#
# To generate them:
#   1. Log in at   https://demo.binance.com/en/futures
#      (this uses your NORMAL Binance account -- not the old separate
#       GitHub/Google testnet login)
#   2. Click the account icon, top right -> API Management
#      or go straight to:
#      https://demo.binance.com/en/my/settings/api-management
#   3. Create API -> give it a name -> copy the key and secret
#
# Demo keys need no IP restriction and no futures permission ceremony. The
# secret is shown once; if you lose it, delete the key and make another.
# Confirm the pair works before saving it here:
#      /usr/bin/python3 run.py verifykey
#
# ---- LIVE (much later, and the ORDER matters) -------------------------------
# Binance will refuse to enable Futures on a key unless you do these in order:
#   1. Open the Futures account first: Derivatives > USD-M Futures > activate.
#      A key created BEFORE the futures account exists can never gain the
#      permission -- it has to be deleted and recreated.
#   2. Make sure Portfolio Margin is OFF. It disables the classic Futures API
#      this bot uses.
#   3. API Management > Create API > System generated.
#   4. Edit restrictions > "Restrict access to trusted IPs only" > enter your
#      Oracle instance's PUBLIC IP > save.
#   5. ONLY NOW does the "Enable Futures" checkbox become available. Tick it.
#   6. Leave withdrawals off. Always.
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=
BINANCE_LIVE_KEY=
BINANCE_LIVE_SECRET=

# ------------------------------------------------------------ mobile alerts
# Telegram is the fastest route to your phone and takes two minutes:
#   1. message @BotFather, send /newbot, copy the token
#   2. message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy the chat id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------- email
# Gmail requires an App Password (Google Account > Security > App passwords),
# not your normal password. Port 587 = STARTTLS, 465 = implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pathirana.sithmal@gmail.com
SMTP_PASSWORD=
ALERT_EMAIL=pathirana.sithmal@gmail.com

# --------------------------------------------------------------- dashboard
# Acts as the password for an endpoint that can close your trades.
# Generate one:  /usr/bin/python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# Leave blank and the bot generates a temporary token each restart.
DASHBOARD_TOKEN=

# ------------------------------------------------------- signal broadcasting
# Optional. A SECOND chat or channel that receives entries and exits only --
# symbol, direction, entry, stop, target. Never your balance, position size or
# P&L. One-way: the bot does not read this channel, so nobody there can send it
# a command.
#
# To set up: create a Telegram channel, add your bot as an administrator, then
# forward a message from it to @userinfobot to get the channel id (starts -100).
TELEGRAM_SIGNAL_CHAT_ID=
